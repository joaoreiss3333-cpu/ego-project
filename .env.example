# Banco (docker compose sobe o Postgres na 5432)
DATABASE_URL="postgresql://ego:ego@localhost:5432/ego?schema=public"

# Discord (Developer Portal > sua aplicação)
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Servidor para registrar os comandos na hora (opcional; sem ele o registro é global)
DISCORD_GUILD_ID=""

# Site
SITE_URL="http://localhost:3000"
AUTH_SECRET="troque-por-um-segredo-longo"
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_URL="http://localhost:3000"
# Redirect do OAuth no Developer Portal: <AUTH_URL>/api/auth/callback/discord
# Pasta dos retratos enviados pelo site (padrão: <raiz>/data/uploads)
UPLOAD_DIR=""
# SOMENTE DESENVOLVIMENTO LOCAL: com DEV_LOGIN=1 (e fora de produção) a página /entrar
# aceita qualquer Discord ID sem senha. Em build de produção ele nunca liga.
DEV_LOGIN=""
