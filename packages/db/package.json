{
  "name": "@ego/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js generate",
    "migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "studio": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js studio",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@ego/content": "workspace:*",
    "@ego/engine": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
